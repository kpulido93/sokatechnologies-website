{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": {
      "radius": true,
      "width": true
    },
    "color": {
      "palette": [
        {
          "name": "Ink",
          "slug": "ink",
          "color": "#08111F"
        },
        {
          "name": "Navy",
          "slug": "navy",
          "color": "#0F1B2D"
        },
        {
          "name": "Blue",
          "slug": "blue",
          "color": "#2563EB"
        },
        {
          "name": "Cyan",
          "slug": "cyan",
          "color": "#0EA5E9"
        },
        {
          "name": "Emerald",
          "slug": "emerald",
          "color": "#10B981"
        },
        {
          "name": "Mist",
          "slug": "mist",
          "color": "#F4F7FB"
        },
        {
          "name": "Surface",
          "slug": "surface",
          "color": "#FFFFFF"
        },
        {
          "name": "Text",
          "slug": "text",
          "color": "#111827"
        },
        {
          "name": "Muted",
          "slug": "muted",
          "color": "#526173"
        },
        {
          "name": "Border",
          "slug": "border",
          "color": "#DCE5EF"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "spacing": {
      "spacingSizes": [
        {
          "name": "2XS",
          "slug": "20",
          "size": "0.5rem"
        },
        {
          "name": "XS",
          "slug": "30",
          "size": "0.75rem"
        },
        {
          "name": "S",
          "slug": "40",
          "size": "1rem"
        },
        {
          "name": "M",
          "slug": "50",
          "size": "1.5rem"
        },
        {
          "name": "L",
          "slug": "60",
          "size": "2.25rem"
        },
        {
          "name": "XL",
          "slug": "70",
          "size": "3.5rem"
        },
        {
          "name": "2XL",
          "slug": "80",
          "size": "5rem"
        }
      ],
      "units": [
        "px",
        "rem",
        "%",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "fluid": false,
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.92rem"
        },
        {
          "name": "Base",
          "slug": "base",
          "size": "1rem"
        },
        {
          "name": "Lead",
          "slug": "lead",
          "size": "1.125rem"
        },
        {
          "name": "H3",
          "slug": "h-3",
          "size": "1.45rem"
        },
        {
          "name": "H2",
          "slug": "h-2",
          "size": "2.1rem"
        },
        {
          "name": "Hero",
          "slug": "hero",
          "size": "3.2rem"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|surface",
      "text": "var:preset|color|text"
    },
    "spacing": {
      "blockGap": "1.35rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system-sans",
      "fontSize": "var:preset|font-size|base",
      "fontWeight": "400",
      "letterSpacing": "0",
      "lineHeight": "1.68"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var:preset|color|blue",
          "text": "var:preset|color|surface"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "right": "1.15rem",
            "bottom": "0.85rem",
            "left": "1.15rem"
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "750"
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "fontWeight": "780",
          "letterSpacing": "0",
          "lineHeight": "1.12"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|blue"
        },
        "typography": {
          "textDecoration": "none"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "999px"
        }
      },
      "core/group": {
        "spacing": {
          "blockGap": "1.25rem"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.94rem",
          "fontWeight": "650"
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "var:preset|font-size|hero",
          "lineHeight": "1.08"
        }
      }
    }
  }
}
