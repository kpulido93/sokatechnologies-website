---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Seo from "../components/Seo.astro";
import type { StructuredData } from "../lib/seo";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  pageName?: string;
  schemas?: StructuredData[];
}

const { title, description, canonicalPath, pageName, schemas = [] } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      pathname={Astro.url.pathname}
      pageName={pageName}
      schemas={schemas}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <Header pathname={Astro.url.pathname} />
    <main id="main-content" class="page-shell">
      <slot />
    </main>
    <Footer />
    <script>
      import { destroySiteMotion, initSiteMotion } from "../scripts/animations/init";

      initSiteMotion();
      window.addEventListener("pagehide", destroySiteMotion, { once: true });
    </script>
  </body>
</html>
