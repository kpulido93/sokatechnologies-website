---
import logo from "../assets/images/logo-sokatechnologies.png";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Seo from "../components/Seo.astro";
import WhatsAppLink from "../components/WhatsAppLink.astro";
import type { StructuredData } from "../lib/seo";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  pageName?: string;
  schemas?: StructuredData[];
}

const { title, description, canonicalPath, pageName, schemas = [] } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      pathname={Astro.url.pathname}
      pageName={pageName}
      schemas={schemas}
    />
    <link rel="icon" href={logo.src} type="image/png" />
    <link rel="apple-touch-icon" href={logo.src} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <Header pathname={Astro.url.pathname} />
    <main id="main-content" class="page-shell">
      <slot />
    </main>
    <Footer />
    <WhatsAppLink variant="floating" />
    <script>
      import { destroySiteMotion, initSiteMotion } from "../scripts/animations/init";

      initSiteMotion();
      window.addEventListener("pagehide", destroySiteMotion, { once: true });
    </script>
  </body>
</html>
