---
import ContactForm from "../components/ContactForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteMeta } from "../lib/site";
---

<BaseLayout
  title="Contacto | SokaTechnologies"
  description="Abrir conversación con SokaTechnologies para revisar software, automatización, Power BI, consultoría TI, infraestructura o soporte."
  canonicalPath="/contacto/"
>
  <section class="page-hero section">
    <p class="eyebrow">Contacto</p>
    <h1>Hablemos de tu proceso, sistema o necesidad tecnológica.</h1>
    <p>
      La primera conversación busca entender el problema, revisar el contexto operativo y definir
      si tiene sentido avanzar a diagnóstico, propuesta, piloto o revisión técnica.
    </p>
  </section>

  <section class="section contact-channels" aria-labelledby="contact-channels-title">
    <div class="section-heading">
      <p class="eyebrow">Canales institucionales</p>
      <h2 id="contact-channels-title">Encuéntranos en {siteMeta.regions}.</h2>
      <p>Usa estos datos para continuar una conversación comercial o solicitar orientación inicial.</p>
    </div>
    <div class="contact-channel-grid">
      <article class="trust-card">
        <p class="eyebrow">Ubicación</p>
        <h3>{siteMeta.regions}</h3>
      </article>
      <article class="trust-card">
        <p class="eyebrow">Teléfono</p>
        <h3><a href={siteMeta.phoneHref}>{siteMeta.phone}</a></h3>
      </article>
      <article class="trust-card">
        <p class="eyebrow">Correo</p>
        <h3><a href={`mailto:${siteMeta.email}`}>{siteMeta.email}</a></h3>
      </article>
    </div>
  </section>

  <ContactForm
    formType="contact"
    title="Solicita una conversación inicial"
    body="Comparte el contexto general del problema, el área afectada, las herramientas actuales y la urgencia. No envíes credenciales, datos sensibles ni accesos."
    buttonLabel="Enviar solicitud inicial"
  />

  <section class="section js-section">
    <div class="trust-grid">
      <article class="trust-card js-reveal-card" data-card-interaction>
        <h3>Qué revisamos</h3>
        <p>Objetivo del proyecto, flujo actual, usuarios involucrados, herramientas existentes y riesgos principales.</p>
      </article>
      <article class="trust-card js-reveal-card" data-card-interaction>
        <h3>Tipos de solicitud</h3>
        <p>Software a medida, automatización, Power BI, consultoría TI y DevOps, sitios web corporativos, infraestructura y soporte.</p>
      </article>
      <article class="trust-card js-reveal-card" data-card-interaction>
        <h3>Qué no atenderemos</h3>
        <p>Spam, evasión de controles, uso indebido de datos, exposición de secretos o actividades sin trazabilidad.</p>
      </article>
    </div>
  </section>
</BaseLayout>
