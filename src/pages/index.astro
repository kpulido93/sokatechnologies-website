---
import HeroVisual from "../components/HeroVisual.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { featuredCaseStudies } from "../data/caseStudies";
import { services } from "../data/services";
import BaseLayout from "../layouts/BaseLayout.astro";
import { noiseProblems, noiseResults, processSteps } from "../lib/site";
---

<BaseLayout
  title="Software, automatización y datos para empresas — SokaTechnologies"
  description="Desarrollamos software a medida, automatizaciones, integraciones, Power BI e infraestructura para ayudar a empresas a operar con más control."
  canonicalPath="/"
>
  <section class="hero section js-hero">
    <div class="hero-copy">
      <p class="eyebrow js-hero-eyebrow">Soluciones tecnológicas para empresas</p>
      <h1 class="js-hero-title">Software, datos e infraestructura para operar con más control</h1>
      <p class="hero-body js-hero-subtitle">
        Partimos del proceso que quieres mejorar y definimos una ruta proporcional de software,
        datos o infraestructura.
      </p>

      <div class="hero-actions">
        <a class="button button-primary js-hero-cta" href="/diagnostico/" data-link-shift>
          Solicitar diagnóstico
        </a>
        <a class="button button-ghost js-hero-cta" href="/proyectos/" data-link-shift>
          Ver proyectos
        </a>
      </div>

      <ul class="hero-signals">
        <li>Diagnóstico antes que plantilla</li>
        <li>Alcance por fases</li>
        <li>Mantenimiento y acompañamiento</li>
      </ul>
    </div>

    <div class="hero-visual js-hero-visual">
      <HeroVisual />
    </div>
  </section>

  <section class="metrics-band section" aria-label="Principios de trabajo">
    <div class="trust-grid">
      <article class="trust-card js-reveal-card" data-card-interaction>
        <p class="eyebrow">Comprensión</p>
        <h2>Primero entendemos el proceso.</h2>
        <p>
          Revisamos la operación, las herramientas, los responsables y los riesgos antes de
          proponer una solución.
        </p>
      </article>
      <article class="trust-card js-reveal-card" data-card-interaction>
        <p class="eyebrow">Alcance</p>
        <h2>Construimos con límites claros.</h2>
        <p>
          Definimos entregables, responsables y criterios de aceptación para reducir ambigüedad
          desde el inicio.
        </p>
      </article>
      <article class="trust-card js-reveal-card" data-card-interaction>
        <p class="eyebrow">Continuidad</p>
        <h2>La solución debe poder mantenerse.</h2>
        <p>
          Acompañamos pruebas, documentación y mejora posterior según las necesidades reales de la
          operación.
        </p>
      </article>
    </div>
  </section>

  <section class="section js-section">
    <SectionHeading
      eyebrow="El problema operativo"
      title="Tu operación necesita procesos conectados, no más herramientas aisladas."
      body="Cuando la información está distribuida entre hojas de cálculo, correos y sistemas desconectados, aumentan las tareas manuales y se dificulta tener una visión confiable del negocio."
    />

    <div class="noise-grid js-noise-transform">
      <article class="noise-panel">
        <h3>Señales frecuentes</h3>
        <ul class="noise-list">
          {noiseProblems.map((item) => <li class="js-noise-problem">{item}</li>)}
        </ul>
      </article>

      <article class="noise-panel noise-panel-result">
        <h3>Lo que podemos ordenar</h3>
        <ul class="noise-list">
          {noiseResults.map((item) => <li class="js-noise-result">{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section js-section">
    <SectionHeading
      eyebrow="Soluciones para necesidades reales"
      title="Una combinación de software, datos e infraestructura para cada operación."
      body="No necesitas elegir la tecnología antes de hablar con nosotros. Primero entendemos el problema y después proponemos alternativas proporcionales."
    />

    <div class="catalog-grid js-services-grid">
      {
        services.map((service) => (
          <article class="catalog-card js-reveal-card" data-card-interaction>
            <p class="eyebrow">{service.title}</p>
            <h3>{service.headline}</h3>
            <p>{service.summary}</p>
            <a
              class="button button-ghost"
              href={service.ctaHref}
              aria-label={`Ver detalle del servicio: ${service.title}`}
              data-link-shift
            >{service.ctaLabel}</a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section js-section js-process">
    <SectionHeading
      eyebrow="Cómo trabajamos"
      title="Antes de desarrollar, entendemos el negocio."
      body="El proceso permite definir mejor el alcance, validar decisiones y construir una solución que pueda evolucionar con la operación."
    />

    <div class="process-shell">
      <div class="process-line js-process-line"></div>
      <div class="process-steps">
        {
          processSteps.map((step, index) => (
            <article class:list={["process-step", "js-process-step", index === 0 && "is-active"]}>
              <span class="process-index">{step.index}</span>
              <div class="process-copy-block">
                <p class="process-label">Etapa {step.index}</p>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section js-section js-cases">
    <SectionHeading
      eyebrow="Proyectos empresariales"
      title="Dos proyectos directos de software e integración."
      body="Presentamos el problema, la intervención y el resultado cualitativo sin exponer nombres, ubicaciones, cifras sensibles ni información operativa."
    />

    <div class="detail-grid">
      {
        featuredCaseStudies.map((project) => (
          <article class="detail-card js-reveal-card" data-card-interaction>
            <p class="eyebrow">Proyecto directo</p>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <p>
              <strong>Resultado cualitativo:</strong> {project.outcomes[0]}.
            </p>
          </article>
        ))
      }
    </div>
    <a class="button button-ghost" href="/proyectos/" data-link-shift>Ver proyectos</a>
  </section>

  <section class="section js-section">
    <SectionHeading
      eyebrow="Dirección técnica"
      title="Experiencia técnica con visión de negocio."
      body="SokaTechnologies está liderada por Kevin Alexander Pulido, Fundador y Director Técnico, con 10 años de experiencia profesional en tecnología."
    />

    <div class="detail-grid">
      <article class="detail-card js-reveal-card" data-card-interaction>
        <p class="eyebrow">Kevin Alexander Pulido</p>
        <h2>Fundador y Director Técnico</h2>
        <p>
          Su experiencia reúne desarrollo de software, bases de datos, infraestructura,
          integraciones, consultoría TI, DevOps y Business Intelligence.
        </p>
        <p>
          Su trayectoria incluye consultoría tecnológica internacional realizada mediante un
          contratante; esas iniciativas no se presentan como contratos directos de
          SokaTechnologies.
        </p>
        <a class="button button-ghost" href="/nosotros/" data-link-shift>Conocer a Kevin</a>
      </article>

      <article class="detail-card js-reveal-card" data-card-interaction>
        <p class="eyebrow">Enfoque consultivo</p>
        <h2>Comprender, proponer y acompañar.</h2>
        <p>
          La conversación empieza por el proceso y sus dificultades. El objetivo es elegir una
          ruta técnica proporcional, con pruebas, documentación y continuidad.
        </p>
        <a class="button button-ghost" href="/diagnostico/" data-link-shift>Solicitar diagnóstico</a>
      </article>
    </div>
  </section>

  <section class="final-panel section js-final-cta">
    <div class="final-shell">
      <p class="eyebrow">Siguiente paso</p>
      <h2>Cuéntanos qué proceso necesita mejorar tu empresa.</h2>
      <p>
        Evaluemos si el siguiente paso es automatizar, integrar, desarrollar software o fortalecer
        infraestructura.
      </p>
      <a class="button button-primary" href="/diagnostico/" data-link-shift>
        Solicitar diagnóstico
      </a>
    </div>
  </section>
</BaseLayout>
