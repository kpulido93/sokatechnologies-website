---
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Proyectos | SokaTechnologies"
  description="El portafolio empresarial de SokaTechnologies se encuentra en la ruta canónica de proyectos."
  canonicalPath="/proyectos/"
  pageName="Proyectos"
>
  <PageHero
    eyebrow="Ruta compatible"
    title="El portafolio empresarial ahora vive en Proyectos."
    body="Conservamos esta URL para evitar un error 404 mientras se aprueba la redirección permanente hacia la ruta canónica."
    primaryCtaLabel="Ver proyectos"
    primaryCtaHref="/proyectos/"
    secondaryCtaLabel="Solicitar diagnóstico"
    secondaryCtaHref="/diagnostico/"
    signals={["ruta compatible", "canonical /proyectos/", "sin catálogo antiguo"]}
  />

  <section class="section js-section">
    <SectionHeading
      eyebrow="Siguiente destino"
      title="Consulta el portafolio actualizado de SokaTechnologies."
      body="La página de proyectos separa los trabajos directos de SokaTechnologies de la experiencia profesional internacional de su fundador y evita publicar información identificable."
    />
    <a class="button button-primary" href="/proyectos/" data-link-shift>Ir a Proyectos</a>
  </section>
</BaseLayout>
