---
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Proyectos | SokaTechnologies"
  description="Explora proyectos de software a medida e integración empresarial desarrollados por SokaTechnologies."
  canonicalPath="/proyectos/"
  pageName="Proyectos"
>
  <PageHero
    eyebrow="Proyectos de SokaTechnologies"
    title="Conoce proyectos empresariales de software e integración."
    body="Explora experiencias reales de desarrollo e integración de sistemas, presentadas sin revelar información sensible de nuestros clientes."
    primaryCtaLabel="Ver proyectos"
    primaryCtaHref="/proyectos/"
    secondaryCtaLabel="Solicitar diagnóstico"
    secondaryCtaHref="/diagnostico/"
    signals={["software a medida", "integración de datos", "resultados reales"]}
  />

  <section class="section js-section">
    <SectionHeading
      eyebrow="Explora nuestros trabajos"
      title="Descubre cómo abordamos desafíos tecnológicos empresariales."
      body="En Proyectos encontrarás soluciones empresariales desarrolladas por SokaTechnologies y, en una sección diferenciada, experiencia profesional internacional de su fundador."
    />
    <a class="button button-primary" href="/proyectos/" data-link-shift>Ir a Proyectos</a>
  </section>
</BaseLayout>
