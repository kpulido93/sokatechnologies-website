---
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services } from "../data/services";
import BaseLayout from "../layouts/BaseLayout.astro";
import { processSteps, siteMeta } from "../lib/site";
---

<BaseLayout
  title="Servicios tecnológicos B2B | SokaTechnologies"
  description="Software a medida, automatizaciones, Power BI, consultoría TI y DevOps, infraestructura cloud/on-prem, sitios web corporativos y soporte."
  canonicalPath="/servicios/"
>
  <div class="interior-page services-page">
    <section class="page-hero section">
      <p class="eyebrow">Servicios</p>
      <h1>Servicios tecnológicos B2B para operar con más control.</h1>
      <p>
        Ayudamos a convertir procesos manuales, datos dispersos y sistemas frágiles en soluciones
        digitales mantenibles, desde software e integraciones hasta Power BI, infraestructura y
        continuidad.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={siteMeta.contactHref} data-link-shift>Abrir conversación</a>
        <a class="button button-ghost" href="/soluciones/" data-link-shift>Explorar por necesidad</a>
      </div>
    </section>

    <section class="section js-section">
      <SectionHeading
        eyebrow="Suite B2B"
        title="Siete áreas para resolver problemas operativos y técnicos concretos."
        body="Cada servicio parte del problema empresarial, define un alcance posible y busca mejorar control, visibilidad, continuidad o capacidad de evolución."
      />

      <div class="service-grid">
        {services.map((service, index) => <ServiceCard service={service} index={index + 1} />)}
    </div>
    </section>

    <section class="section js-section">
      <SectionHeading
        eyebrow="Método"
        title="Antes de implementar, entendemos el proceso."
        body="Eso permite definir mejor el alcance, reducir ambigüedad y construir una solución proporcional al objetivo."
      />

      <div class="mini-process-grid">
        {
          processSteps.map((step) => (
            <article class="mini-process-card js-reveal-card" data-card-interaction>
              <span>{step.index}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="final-panel section js-final-cta">
      <div class="final-shell">
        <p class="eyebrow">Diagnóstico</p>
        <h2>Si el alcance no está claro, vale más definir primero que construir sobre supuestos.</h2>
        <p>
          El primer paso recomendado es revisar el proceso, los usuarios, las herramientas actuales
          y los riesgos antes de proponer una solución cerrada.
        </p>
        <a class="button button-primary" href={siteMeta.contactHref} data-link-shift>Abrir conversación</a>
      </div>
    </section>
  </div>
</BaseLayout>
