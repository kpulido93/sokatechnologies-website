---
import PageHero from "../../components/PageHero.astro";
import ProductCard from "../../components/ProductCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { products } from "../../data/products";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Productos | SokaTechnologies"
  description="Herramientas y demos de SokaTechnologies para necesidades operativas concretas, con alcance y límites descritos en cada ficha."
  canonicalPath="/productos/"
>
  <PageHero
    eyebrow="Productos"
    title="Herramientas para necesidades operativas concretas."
    body="Cada ficha explica su propósito, lo que puedes evaluar y los límites actuales de Portik, AutoInventario y AutoWhatsapp."
    primaryCtaLabel="Solicitar diagnóstico"
    primaryCtaHref="/diagnostico/"
    secondaryCtaLabel="Ver proyectos"
    secondaryCtaHref="/proyectos/"
    signals={["Portik en validación", "AutoInventario en revisión", "AutoWhatsapp controlado"]}
  />

  <section class="section js-section">
    <SectionHeading
      eyebrow="Catálogo"
      title="Qué puedes evaluar de cada producto."
      body="Aquí puedes conocer qué se puede evaluar hoy, qué necesita validación adicional y qué límites comerciales o técnicos deben respetarse."
    />
    <div class="catalog-grid">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="final-panel section js-final-cta">
    <div class="final-shell">
      <p class="eyebrow">Siguiente paso</p>
      <h2>Si el producto correcto no está claro, conviene partir del problema operativo.</h2>
      <p>
        El diagnóstico permite decidir si el siguiente paso es Portik, una revisión técnica de
        AutoInventario, una evaluación controlada de AutoWhatsapp o un desarrollo a medida.
      </p>
      <a class="button button-primary" href="/diagnostico/" data-link-shift>Solicitar diagnóstico</a>
    </div>
  </section>
</BaseLayout>
