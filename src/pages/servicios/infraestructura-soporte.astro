---
import ServiceSeoPage from "../../components/ServiceSeoPage.astro";
import { caseStudies } from "../../data/caseStudies";
import { getServiceBySlug } from "../../data/services";

const service = getServiceBySlug("infraestructura-soporte");

if (!service) {
  throw new Error("Infraestructura y soporte content is required to render this page.");
}

const relatedCases = caseStudies.filter((caseStudy) => service.relatedCaseSlugs.includes(caseStudy.slug));
---

<ServiceSeoPage
  service={service}
  relatedCases={relatedCases}
  canonicalPath="/servicios/infraestructura-soporte/"
/>
