---
import ServiceSeoPage from "../../components/ServiceSeoPage.astro";
import { getServiceBySlug } from "../../data/services";

const service = getServiceBySlug("infraestructura-soporte");

if (!service) {
  throw new Error("Infraestructura cloud/on-prem content is required to render this page.");
}

---

<ServiceSeoPage
  service={service}
  canonicalPath="/servicios/infraestructura-soporte/"
/>
