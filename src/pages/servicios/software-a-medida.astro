---
import ServiceSeoPage from "../../components/ServiceSeoPage.astro";
import { getServiceBySlug } from "../../data/services";

const service = getServiceBySlug("software-a-medida");

if (!service) {
  throw new Error("Software a medida content is required to render this page.");
}

---

<ServiceSeoPage
  service={service}
  canonicalPath="/servicios/software-a-medida/"
/>
