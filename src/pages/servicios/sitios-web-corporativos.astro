---
import ServiceSeoPage from "../../components/ServiceSeoPage.astro";
import { getServiceBySlug } from "../../data/services";

const service = getServiceBySlug("sitios-web-corporativos");

if (!service) {
  throw new Error("Sitios web corporativos content is required to render this page.");
}

---

<ServiceSeoPage
  service={service}
  canonicalPath="/servicios/sitios-web-corporativos/"
/>
