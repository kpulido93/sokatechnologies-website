---
import AuditReportPreview from "./AuditReportPreview.astro";
import { auditCompanyTypes } from "../data/auditAreas";
import { siteMeta } from "../lib/site";

const fallbackEmail = import.meta.env.PUBLIC_CONTACT_FALLBACK_EMAIL?.trim() || siteMeta.email;
const formId = "audit-request-form";
const successId = `${formId}-success`;
const errorId = `${formId}-error`;
const loadingId = `${formId}-loading`;
const issuesId = `${formId}-issues`;
const noteId = `${formId}-note`;
const previewId = `${formId}-preview`;
---

<form
  id={formId}
  class="contact-form audit-form js-reveal"
  method="post"
  data-mode="demo"
  data-form-mode="demo"
  data-endpoint="/api/audit"
  data-success-id={successId}
  data-error-id={errorId}
  data-loading-id={loadingId}
  data-issues-id={issuesId}
  data-preview-id={previewId}
  aria-describedby={noteId}
>
  <input type="hidden" name="formContext" value="Auditoría web y operación digital" />

  <p id={noteId} class="form-note form-demo-notice">
    Modo demo: esta simulación local se basa en tus respuestas. No evalúa ni escanea la URL, no
    envía solicitudes ni correos y no almacena datos.
  </p>

  <label class="form-trap" aria-hidden="true" inert>
    <span>Website</span>
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </label>

  <div class="field-grid">
    <label for={`${formId}-website-url`}>
      <span>URL del sitio web</span>
      <input
        id={`${formId}-website-url`}
        type="url"
        name="websiteUrl"
        data-error-id={`${formId}-website-url-error`}
        aria-describedby={`${formId}-website-url-hint ${formId}-website-url-error`}
        placeholder="https://tuempresa.com"
        inputmode="url"
        maxlength="200"
        required
      />
      <p id={`${formId}-website-url-hint`} class="field-hint">La URL sirve como contexto para la simulación. En modo demo no se visita ni se escanea.</p>
      <span id={`${formId}-website-url-error`} class="field-error" role="alert" hidden></span>
    </label>

    <label for={`${formId}-name`}>
      <span>Nombre</span>
      <input
        id={`${formId}-name`}
        type="text"
        name="name"
        data-error-id={`${formId}-name-error`}
        aria-describedby={`${formId}-name-error`}
        autocomplete="name"
        minlength="2"
        maxlength="80"
        required
      />
      <span id={`${formId}-name-error`} class="field-error" role="alert" hidden></span>
    </label>

    <label for={`${formId}-company`}>
      <span>Empresa</span>
      <input
        id={`${formId}-company`}
        type="text"
        name="company"
        data-error-id={`${formId}-company-error`}
        aria-describedby={`${formId}-company-error`}
        autocomplete="organization"
        minlength="2"
        maxlength="120"
        required
      />
      <span id={`${formId}-company-error`} class="field-error" role="alert" hidden></span>
    </label>

    <label for={`${formId}-email`}>
      <span>Email</span>
      <input
        id={`${formId}-email`}
        type="email"
        name="email"
        data-error-id={`${formId}-email-error`}
        aria-describedby={`${formId}-email-error`}
        autocomplete="email"
        inputmode="email"
        maxlength="120"
        required
      />
      <span id={`${formId}-email-error`} class="field-error" role="alert" hidden></span>
    </label>

    <label for={`${formId}-whatsapp`}>
      <span>WhatsApp opcional</span>
      <input
        id={`${formId}-whatsapp`}
        type="tel"
        name="whatsapp"
        data-error-id={`${formId}-whatsapp-error`}
        aria-describedby={`${formId}-whatsapp-hint ${formId}-whatsapp-error`}
        inputmode="tel"
        autocomplete="tel"
        maxlength="30"
      />
      <p id={`${formId}-whatsapp-hint`} class="field-hint">Opcional. Solo si prefieres seguimiento por ese canal.</p>
      <span id={`${formId}-whatsapp-error`} class="field-error" role="alert" hidden></span>
    </label>

    <label for={`${formId}-country`}>
      <span>País</span>
      <input
        id={`${formId}-country`}
        type="text"
        name="country"
        data-error-id={`${formId}-country-error`}
        aria-describedby={`${formId}-country-error`}
        autocomplete="country-name"
        maxlength="80"
        required
      />
      <span id={`${formId}-country-error`} class="field-error" role="alert" hidden></span>
    </label>

    <label for={`${formId}-company-type`}>
      <span>Tipo de empresa</span>
      <select
        id={`${formId}-company-type`}
        name="companyType"
        data-error-id={`${formId}-company-type-error`}
        aria-describedby={`${formId}-company-type-error`}
        required
      >
        <option value="">Selecciona una opción</option>
        {auditCompanyTypes.map((option) => <option value={option}>{option}</option>)}
      </select>
      <span id={`${formId}-company-type-error`} class="field-error" role="alert" hidden></span>
    </label>
  </div>

  <label class="field-block" for={`${formId}-main-problem`}>
    <span>Principal problema</span>
    <textarea
      id={`${formId}-main-problem`}
      name="mainProblem"
      data-error-id={`${formId}-main-problem-error`}
      aria-describedby={`${formId}-main-problem-hint ${formId}-main-problem-error`}
      rows="6"
      minlength="30"
      maxlength="1200"
      placeholder="Describe qué te preocupa más: claridad comercial, conversión, seguimiento manual, velocidad, confianza o continuidad técnica."
      required
    ></textarea>
    <p id={`${formId}-main-problem-hint`} class="field-hint">
      No compartas contraseñas, tokens, paneles, capturas internas ni información sensible.
    </p>
    <span id={`${formId}-main-problem-error`} class="field-error" role="alert" hidden></span>
  </label>

  <label class="checkbox-line" for={`${formId}-consent`}>
    <input
      id={`${formId}-consent`}
      type="checkbox"
      name="consent"
      data-error-id={`${formId}-consent-error`}
      aria-describedby={`${formId}-consent-error`}
      required
    />
    <span class="checkbox-copy">
      Acepto que SokaTechnologies me contacte sobre esta auditoría y confirmo que no enviaré
      contraseñas, tokens, llaves privadas ni accesos. Consulta la
      <a href="/politica-privacidad/">política de privacidad</a>.
      <span id={`${formId}-consent-error`} class="field-error" role="alert" hidden></span>
    </span>
  </label>

  <div class="form-actions">
    <button class="button button-primary" type="submit">Ver simulación de prueba</button>
    <a class="button button-ghost" href={`mailto:${fallbackEmail}`} data-link-shift>
      Escribir por correo
    </a>
  </div>

  <p id={loadingId} class="form-status form-status-loading" role="status" aria-live="polite" hidden>
    Revisando la solicitud y generando una vista previa inicial...
  </p>

  <p id={successId} class="form-status" role="status" aria-live="polite" hidden>
    Simulación local generada a partir de tus respuestas. No se evaluó ni escaneó la URL y no se
    enviaron ni almacenaron datos.
  </p>

  <p id={errorId} class="form-status form-status-error" role="alert" hidden>
    No se pudo procesar la solicitud. Revisa los campos requeridos y evita incluir datos sensibles.
  </p>

  <ul id={issuesId} class="form-issues" hidden></ul>

  <AuditReportPreview id={previewId} />
</form>

<script>
  import { initAuditForms } from "../scripts/auditForm";

  initAuditForms();
</script>
