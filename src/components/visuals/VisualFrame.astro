---
interface Props {
  eyebrow: string;
  title: string;
  status?: string;
}

const { eyebrow, title, status = "vista abstracta" } = Astro.props;
---

<article class="visual-panel js-visual-panel" data-card-interaction>
  <header class="visual-panel__head">
    <div>
      <p class="visual-panel__eyebrow">{eyebrow}</p>
      <h3 class="visual-panel__title">{title}</h3>
    </div>
    <span class="visual-panel__status">{status}</span>
  </header>

  <div class="visual-panel__body">
    <slot />
  </div>
</article>

<style is:global>
  .visual-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(1rem, 2.4vw, 1.4rem);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-lg) + 0.15rem);
    background:
      radial-gradient(circle at 12% 16%, rgba(85, 176, 255, 0.14), transparent 26%),
      radial-gradient(circle at 88% 12%, rgba(34, 212, 191, 0.12), transparent 22%),
      linear-gradient(180deg, rgba(11, 24, 40, 0.96), rgba(7, 15, 26, 0.96));
    backdrop-filter: blur(18px);
    box-shadow: var(--shadow-panel);
  }

  .visual-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.06), transparent 25%),
      linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.02));
  }

  .visual-panel::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(144, 217, 255, 0.8), transparent);
    opacity: 0.65;
  }

  .visual-panel__head,
  .visual-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.9rem;
  }

  .visual-panel__head {
    margin-bottom: 1rem;
  }

  .visual-panel__eyebrow,
  .visual-label {
    margin: 0;
    color: var(--color-accent-soft);
    font-family: var(--font-display);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .visual-panel__title,
  .visual-stat strong,
  .visual-card strong,
  .visual-flow__node strong,
  .visual-topology__node strong {
    display: block;
    margin: 0;
    font-family: var(--font-display);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .visual-panel__title {
    font-size: clamp(1.3rem, 2.2vw, 1.85rem);
  }

  .visual-panel__status,
  .visual-chip,
  .visual-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.48rem 0.72rem;
    border: 1px solid rgba(144, 217, 255, 0.18);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: 0.78rem;
    white-space: nowrap;
    background: rgba(8, 18, 31, 0.66);
  }

  .visual-panel__body,
  .visual-stack,
  .visual-card__body {
    display: grid;
    gap: 1rem;
  }

  .visual-grid,
  .visual-mini-grid,
  .visual-stat-strip,
  .visual-module-grid {
    display: grid;
    gap: 0.8rem;
  }

  .visual-grid--two {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr);
  }

  .visual-mini-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .visual-stat-strip {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .visual-module-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .visual-stat,
  .visual-card,
  .visual-flow__node,
  .visual-topology__node,
  .visual-mini-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(135, 170, 230, 0.14);
    border-radius: calc(var(--radius-md) - 0.15rem);
    background: rgba(8, 18, 31, 0.74);
  }

  .visual-stat,
  .visual-mini-card {
    padding: 0.95rem;
  }

  .visual-card {
    padding: 1rem;
  }

  .visual-stat small,
  .visual-card p,
  .visual-flow__node p,
  .visual-topology__node p,
  .visual-note,
  .visual-list span,
  .visual-topology__legend li,
  .visual-line-legend,
  .visual-bar-label {
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .visual-stat strong,
  .visual-card strong,
  .visual-flow__node strong,
  .visual-topology__node strong {
    font-size: clamp(1rem, 1.7vw, 1.25rem);
  }

  .visual-stat strong {
    margin-top: 0.35rem;
  }

  .visual-note {
    margin: 0;
    font-size: 0.92rem;
  }

  .visual-list,
  .visual-bar-list,
  .visual-topology__legend {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .visual-list,
  .visual-bar-list {
    display: grid;
    gap: 0.7rem;
  }

  .visual-list li,
  .visual-mini-card,
  .visual-bar-list li {
    padding: 0.78rem 0.85rem;
    border: 1px solid rgba(135, 170, 230, 0.12);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .visual-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .visual-list strong,
  .visual-mini-card strong {
    font-size: 0.96rem;
  }

  .visual-list small,
  .visual-mini-card small {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .visual-pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .visual-pill {
    color: #d9e9f7;
    background: rgba(10, 24, 38, 0.72);
  }

  .visual-meter,
  .visual-bar {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
  }

  .visual-meter {
    height: 0.7rem;
  }

  .visual-meter span,
  .visual-bar span {
    display: block;
    width: var(--meter-size, 50%);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-secondary));
    box-shadow: 0 0 24px rgba(85, 176, 255, 0.24);
  }

  .visual-bar {
    grid-column: 1 / -1;
    height: 0.58rem;
  }

  .visual-bar-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.55rem 0.9rem;
  }

  .visual-sparkbars {
    display: flex;
    align-items: flex-end;
    gap: 0.42rem;
    min-height: 5rem;
  }

  .visual-sparkbars span {
    flex: 1 1 0;
    height: var(--bar-size, 50%);
    min-width: 0.45rem;
    border-radius: var(--radius-pill);
    background: linear-gradient(180deg, rgba(85, 176, 255, 0.92), rgba(34, 212, 191, 0.5));
    box-shadow: 0 0 22px rgba(34, 212, 191, 0.14);
  }

  .visual-line-chart {
    width: 100%;
    height: auto;
    margin-top: 0.5rem;
  }

  .visual-line-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.84rem;
  }

  .visual-line-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .visual-line-legend i,
  .visual-dot {
    display: inline-block;
    width: 0.58rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 18px rgba(85, 176, 255, 0.45);
  }

  .visual-line-legend i.is-mint,
  .visual-dot.is-mint {
    background: var(--color-accent-secondary);
  }

  .visual-flow {
    display: flex;
    align-items: stretch;
    gap: 0.65rem;
    overflow-x: auto;
    padding-bottom: 0.2rem;
  }

  .visual-flow__node {
    flex: 1 0 10.8rem;
    padding: 0.95rem;
  }

  .visual-flow__node p {
    margin: 0.45rem 0 0;
    font-size: 0.84rem;
  }

  .visual-flow__connector {
    flex: 1 0 1.75rem;
    align-self: center;
    height: 2px;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, rgba(85, 176, 255, 0.14), rgba(85, 176, 255, 0.9), rgba(34, 212, 191, 0.9));
    box-shadow: 0 0 18px rgba(85, 176, 255, 0.16);
  }

  .visual-topology {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    min-height: 17rem;
    padding: 1rem;
    border: 1px solid rgba(135, 170, 230, 0.12);
    border-radius: calc(var(--radius-md) - 0.1rem);
    background: rgba(8, 18, 31, 0.52);
  }

  .visual-topology__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.92;
  }

  .visual-topology__node {
    z-index: 1;
    align-self: center;
    padding: 0.9rem;
    text-align: left;
  }

  .visual-topology__node p {
    margin: 0.4rem 0 0;
    font-size: 0.82rem;
  }

  .visual-topology__node--edge {
    grid-column: 1;
    grid-row: 1;
  }

  .visual-topology__node--apps {
    grid-column: 2;
    grid-row: 1;
  }

  .visual-topology__node--observe {
    grid-column: 3;
    grid-row: 1;
  }

  .visual-topology__node--data {
    grid-column: 2;
    grid-row: 2;
  }

  .visual-topology__node--backup {
    grid-column: 3;
    grid-row: 2;
  }

  .visual-topology__legend {
    display: grid;
    gap: 0.6rem;
  }

  .visual-topology__legend li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .visual-cluster {
    display: grid;
    gap: 0.8rem;
  }

  .visual-card p,
  .visual-mini-card p,
  .visual-panel__title {
    text-wrap: balance;
  }

  @media (max-width: 980px) {
    .visual-grid--two,
    .visual-stat-strip,
    .visual-module-grid,
    .visual-mini-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .visual-panel__head,
    .visual-card__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .visual-flow {
      flex-direction: column;
      overflow: visible;
    }

    .visual-flow__connector {
      width: 2px;
      height: 1.5rem;
      align-self: flex-start;
      margin-left: 1rem;
      background: linear-gradient(180deg, rgba(85, 176, 255, 0.14), rgba(85, 176, 255, 0.9), rgba(34, 212, 191, 0.9));
    }

    .visual-topology {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .visual-topology__lines {
      display: none;
    }

    .visual-topology__node--edge,
    .visual-topology__node--apps,
    .visual-topology__node--observe,
    .visual-topology__node--data,
    .visual-topology__node--backup {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
