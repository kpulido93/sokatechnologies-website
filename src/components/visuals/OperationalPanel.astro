---
import VisualFrame from "./VisualFrame.astro";

const cadenceBars = ["34%", "48%", "42%", "66%", "58%", "74%", "69%"];
---

<VisualFrame eyebrow="Operación" title="Panel operativo consultivo" status="ritmo estable">
  <div class="visual-stat-strip">
    <article class="visual-stat js-visual-card" data-card-interaction>
      <span class="visual-label">Trazabilidad</span>
      <strong>Procesos visibles</strong>
      <small>prioridades, incidencias y seguimiento sin depender de hojas sueltas</small>
    </article>
    <article class="visual-stat js-visual-card" data-card-interaction>
      <span class="visual-label">Automatización</span>
      <strong>06 flujos activos</strong>
      <small>validaciones, tareas internas y confirmaciones operativas</small>
    </article>
    <article class="visual-stat js-visual-card" data-card-interaction>
      <span class="visual-label">Reportes</span>
      <strong>Lectura ejecutiva</strong>
      <small>estado semanal y puntos de atención listos para revisión</small>
    </article>
    <article class="visual-stat js-visual-card" data-card-interaction>
      <span class="visual-label">Soporte</span>
      <strong>Continuidad útil</strong>
      <small>documentación mínima, backups y control de cambios</small>
    </article>
  </div>

  <div class="visual-grid visual-grid--two">
    <section class="visual-card js-visual-card" data-card-interaction>
      <div class="visual-card__head">
        <div>
          <p class="visual-label">Cadencia operativa</p>
          <strong>Seguimiento semanal</strong>
        </div>
        <span class="visual-chip">panel editorial</span>
      </div>

      <svg class="visual-line-chart" viewBox="0 0 420 180" aria-hidden="true">
        <defs>
          <linearGradient id="ops-line" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#55b0ff"></stop>
            <stop offset="100%" stop-color="#22d4bf"></stop>
          </linearGradient>
        </defs>
        <path d="M24 142H396" stroke="rgba(146,166,195,0.18)" stroke-width="1"></path>
        <path d="M24 104H396" stroke="rgba(146,166,195,0.12)" stroke-width="1"></path>
        <path d="M24 66H396" stroke="rgba(146,166,195,0.12)" stroke-width="1"></path>
        <polyline
          fill="none"
          stroke="url(#ops-line)"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="4"
          points="24,130 78,116 132,120 186,92 240,98 294,76 348,84 396,62"
        ></polyline>
        <polyline
          fill="none"
          stroke="rgba(237,243,251,0.54)"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          stroke-dasharray="4 7"
          points="24,146 78,144 132,136 186,132 240,124 294,112 348,102 396,98"
        ></polyline>
      </svg>

      <div class="visual-line-legend">
        <span><i></i> eventos priorizados</span>
        <span><i class="is-mint"></i> revisiones completadas</span>
      </div>
    </section>

    <section class="visual-card js-visual-card" data-card-interaction>
      <div class="visual-card__head">
        <div>
          <p class="visual-label">Visibilidad</p>
          <strong>Señales clave</strong>
        </div>
        <span class="visual-chip">diagnóstico</span>
      </div>

      <ul class="visual-list">
        <li>
          <span>Alertas con seguimiento</span>
          <strong>03</strong>
        </li>
        <li>
          <span>Bloqueos operativos activos</span>
          <strong>01</strong>
        </li>
        <li>
          <span>Reportes pendientes de revisión</span>
          <strong>02</strong>
        </li>
      </ul>

      <div class="visual-stack">
        <p class="visual-note">Cobertura de trazabilidad</p>
        <div class="visual-meter">
          <span style="--meter-size: 72%;"></span>
        </div>
      </div>
    </section>
  </div>

  <section class="visual-card js-visual-card" data-card-interaction>
    <div class="visual-card__head">
      <div>
        <p class="visual-label">Cadencia</p>
        <strong>Ritmo de revisión</strong>
      </div>
      <span class="visual-chip">sin datos reales</span>
    </div>

    <div class="visual-sparkbars" aria-hidden="true">
      {cadenceBars.map((size) => <span style={`--bar-size: ${size};`}></span>)}
    </div>
  </section>
</VisualFrame>
