---
import PageHero from "./PageHero.astro";
import SectionHeading from "./SectionHeading.astro";
import type { ServiceContent } from "../data/types";
import { absoluteUrl, createFaqSchema, createServiceSchema } from "../lib/seo";
import BaseLayout from "../layouts/BaseLayout.astro";
import { processSteps } from "../lib/site";

interface Props {
  service: ServiceContent;
  canonicalPath: string;
}

const { service, canonicalPath } = Astro.props;
const schemas = [
  createServiceSchema(service, absoluteUrl(canonicalPath)),
  createFaqSchema(service.faqs)
];
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  canonicalPath={canonicalPath}
  pageName={service.title}
  schemas={schemas}
>
  <div class="interior-page service-detail-page">
    <PageHero
      eyebrow={service.title}
      title={service.heroTitle}
      body={service.heroBody}
      primaryCtaLabel={service.primaryCtaLabel}
      primaryCtaHref={service.primaryCtaHref}
      secondaryCtaLabel={service.secondaryCtaLabel}
      secondaryCtaHref={service.secondaryCtaHref}
      signals={service.tags}
    />

  <section class="section js-section">
    <SectionHeading
      eyebrow="Dolor del cliente"
      title={`Dónde suele aparecer el problema en ${service.title.toLowerCase()}.`}
      body={service.problem}
    />
    <div class="detail-grid">
      <article class="detail-card js-reveal-card" data-card-interaction>
        <h2>Señales frecuentes</h2>
        <ul class="detail-list">
          {service.painSignals.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="detail-card js-reveal-card" data-card-interaction>
        <h2>Qué suele pasar si no se corrige</h2>
        <p>{service.problem}</p>
        <p class="case-note">{service.confidentialityNote}</p>
      </article>
    </div>
  </section>

  <section class="section js-section">
    <SectionHeading
      eyebrow="Qué resuelve Soka"
      title={`Cómo abordamos ${service.title.toLowerCase()} con criterio operativo.`}
      body={service.solution}
    />
    <div class="detail-grid">
      <article class="detail-card js-reveal-card" data-card-interaction>
        <h2>Resultados que se buscan construir</h2>
        <ul class="detail-list">
          {service.outcomes.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="detail-card js-reveal-card" data-card-interaction>
        <h2>Entregables frecuentes</h2>
        <ul class="detail-list">
          {service.deliverables.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section js-section">
    <SectionHeading
      eyebrow="Alcance habitual"
      title={`Para quién y hasta dónde llega ${service.title.toLowerCase()}.`}
      body={service.audience}
    />
    <div class="detail-grid">
      <article class="detail-card js-reveal-card" data-card-interaction>
        <h2>Incluye habitualmente</h2>
        <ul class="detail-list">
          {service.includes.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="detail-card js-reveal-card" data-card-interaction>
        <h2>Fuera de alcance por defecto</h2>
        <ul class="detail-list">
          {(service.exclusions ?? []).map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section js-section">
    <SectionHeading
      eyebrow="Proceso"
      title={`Cómo trabajamos este tipo de servicio.`}
      body="El diagnóstico define alcance, prioridades y límites antes de entrar a implementación, pruebas o continuidad."
    />
    <div class="mini-process-grid">
      {
        processSteps.map((step) => (
          <article class="mini-process-card js-reveal-card" data-card-interaction>
            <span>{step.index}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section js-section">
    <SectionHeading
      eyebrow="Preguntas frecuentes"
      title={`Dudas habituales sobre ${service.title.toLowerCase()}.`}
      body="La intención es dejar claro encaje, límites y siguiente paso comercial sin prometer resultados específicos."
    />
    <div class="faq-stack">
      {
        service.faqs.map((faq, index) => {
          const faqId = `${service.slug}-faq-${index + 1}`;
          const answerId = `${faqId}-answer`;

          return (
            <details id={faqId} class="faq-item js-reveal-card" data-card-interaction>
              <summary aria-controls={answerId}>{faq.question}</summary>
              <p id={answerId}>{faq.answer}</p>
            </details>
          );
        })
      }
    </div>
  </section>

    <section class="final-panel section js-final-cta">
      <div class="final-shell">
        <p class="eyebrow">Diagnóstico</p>
        <h2>{service.finalCtaTitle}</h2>
        <p>{service.finalCtaBody}</p>
        <a class="button button-primary" href="/diagnostico/" data-link-shift>Solicitar diagnóstico</a>
      </div>
    </section>
  </div>
</BaseLayout>
