<div class="hero-panel js-hero-panel">
  <div class="hero-panel-head">
    <span class="panel-chip">malla operativa</span>
    <span class="panel-chip">control consultivo</span>
  </div>

  <div class="hero-visual-grid">
    <article class="hero-panel-card card-main js-hero-panel-card" data-card-interaction>
      <p class="card-label">Operación</p>
      <strong>Estado general estable</strong>
      <div class="card-meter">
        <span style="--meter-size: 82%;"></span>
      </div>
      <ul class="panel-list">
        <li>Procesos priorizados</li>
        <li>Incidencias visibles</li>
      </ul>
    </article>

    <article class="hero-panel-card card-side js-hero-panel-card" data-card-interaction>
      <p class="card-label">Automatización</p>
      <strong>Flujos activos</strong>
      <div class="signal-row">
        <span class="hero-signal js-hero-signal"></span>
        <span class="hero-signal js-hero-signal is-cyan"></span>
        <span class="hero-signal js-hero-signal is-mint"></span>
      </div>
      <p class="card-note">Reglas, validaciones y seguimiento de tareas.</p>
    </article>

    <article class="hero-panel-card card-report js-hero-panel-card" data-card-interaction>
      <p class="card-label">Reportes</p>
      <strong>Lectura ejecutiva</strong>
      <div class="bar-cluster">
        <span style="--bar-size: 46%;"></span>
        <span style="--bar-size: 64%;"></span>
        <span style="--bar-size: 58%;"></span>
        <span style="--bar-size: 78%;"></span>
      </div>
      <p class="card-note">Indicadores simples para decidir más rápido.</p>
    </article>

    <article class="hero-panel-card card-portik js-hero-panel-card" data-card-interaction>
      <p class="card-label">Portik</p>
      <strong>Módulo destacado</strong>
      <div class="module-pill-group">
        <span>visitantes</span>
        <span>vehículos</span>
        <span>bitácora</span>
      </div>
      <p class="card-note">Producto propio para control operativo residencial.</p>
    </article>

    <article class="hero-panel-card card-support js-hero-panel-card" data-card-interaction>
      <p class="card-label">Infraestructura</p>
      <strong>Continuidad y soporte</strong>
      <ul class="panel-list">
        <li>backups verificados</li>
        <li>monitoreo básico</li>
        <li>documentación mínima útil</li>
      </ul>
    </article>
  </div>
</div>
