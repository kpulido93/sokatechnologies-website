---
import { Picture } from "astro:assets";
import orchestrationImage from "../assets/images/hero-orquestacion-datos-procesos.png";
---

<div class="hero-panel js-hero-panel" role="group" aria-label="Ilustración conceptual de datos, procesos e infraestructura conectados">
  <div class="hero-panel-head">
    <span class="panel-chip">orquestación de datos</span>
    <span class="panel-chip">visualización conceptual</span>
  </div>

  <figure class="hero-image-figure">
    <Picture
      src={orchestrationImage}
      widths={[480, 720, 960, 1200, 1448]}
      sizes="(min-width: 1081px) 46vw, 100vw"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      width={1448}
      height={1086}
      alt="Ilustración conceptual de fuentes de datos conectadas con procesos, decisiones e infraestructura"
      loading="eager"
      fetchpriority="high"
    />
    <figcaption>Orquestación de datos y procesos · Visualización conceptual</figcaption>
  </figure>
</div>
