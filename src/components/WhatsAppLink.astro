---
import { siteMeta } from "../lib/site";

interface Props {
  variant?: "floating" | "button" | "footer";
}

const { variant = "button" } = Astro.props;
---

<a
  class:list={[
    "whatsapp-link",
    variant === "floating" && "whatsapp-float",
    variant === "button" && "button button-whatsapp",
    variant === "footer" && "whatsapp-footer"
  ]}
  href={siteMeta.whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp a SokaTechnologies (se abre en otra pestaña)"
  data-whatsapp-link
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    <path d="M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20l1.2-4.8A8.5 8.5 0 1 1 20.5 11.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
    <path d="m8.7 7.3 1.3 2.6-1.1 1.2c.7 1.5 1.9 2.7 3.4 3.4l1.2-1.1 2.6 1.3c.1 1.2-.8 2-2 1.8-3.7-.6-6.8-3.7-7.4-7.4-.2-1.2.7-2.1 2-1.8Z" fill="currentColor" />
  </svg>
  <span>{variant === "floating" ? "WhatsApp" : "Escribir por WhatsApp"}</span>
</a>
