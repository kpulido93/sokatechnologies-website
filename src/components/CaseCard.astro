---
import type { CaseStudyContent } from "../data/types";

interface Props {
  caseStudy: CaseStudyContent;
}

const { caseStudy } = Astro.props;
const visibilityLabel =
  caseStudy.visibility === "anonymized"
    ? "caso anonimizado"
    : caseStudy.visibility === "public"
      ? "proyecto directo"
      : "caso controlado";
const caseTags = [...new Set([...caseStudy.servicesApplied, ...caseStudy.tags])];
const metaLabels =
  caseStudy.region.toLocaleLowerCase() === visibilityLabel
    ? [caseStudy.region]
    : [caseStudy.region, visibilityLabel];
---

<article class="case-card js-case-card js-reveal-card" data-card-interaction>
  <div class="case-meta">
    {metaLabels.map((label) => <span>{label}</span>)}
  </div>
  <h3>{caseStudy.title}</h3>
  <p>{caseStudy.summary}</p>
  <dl class="case-flow">
    <div>
      <dt>Problema</dt>
      <dd>{caseStudy.problem}</dd>
    </div>
    <div>
      <dt>Intervención</dt>
      <dd>{caseStudy.solution}</dd>
    </div>
    <div>
      <dt>Resultado cualitativo</dt>
      <dd>{caseStudy.outcomes[0]}</dd>
    </div>
  </dl>
  <div>
    <p class="eyebrow">Servicios y temas</p>
    <div class="case-tags">
      {caseTags.map((tag) => <span>{tag}</span>)}
    </div>
  </div>
  <p class="case-note">{caseStudy.confidentialityNote}</p>
  <a class="button button-ghost" href={caseStudy.ctaHref} data-link-shift>{caseStudy.ctaLabel}</a>
</article>
