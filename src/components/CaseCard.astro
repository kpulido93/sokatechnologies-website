---
import type { CaseStudyContent } from "../data/types";
import { Picture } from "astro:assets";
import crmImage from "../assets/images/proyecto-registros-sincronizacion-crm.png";
import rolesImage from "../assets/images/proyecto-solicitudes-roles.png";

interface Props {
  caseStudy: CaseStudyContent;
}

const { caseStudy } = Astro.props;
const visibilityLabel =
  caseStudy.visibility === "anonymized"
    ? "caso anonimizado"
    : caseStudy.visibility === "public"
      ? "proyecto directo"
      : "caso controlado";
const caseTags = [
  ...new Set(
    [...caseStudy.servicesApplied, ...caseStudy.tags].map((tag) =>
      tag.trim().toLocaleLowerCase() === "base de datos" ? "bases de datos" : tag
    )
  )
];
const metaLabels =
  caseStudy.region.toLocaleLowerCase() === visibilityLabel
    ? [caseStudy.region]
    : [caseStudy.region, visibilityLabel];
const projectImage =
  caseStudy.slug === "integracion-datos-crm"
    ? {
        src: crmImage,
        alt: "Panel conceptual de registros, fuentes y sincronización con CRM"
      }
    : caseStudy.slug === "plataforma-empresarial-integral"
      ? {
          src: rolesImage,
          alt: "Panel conceptual de solicitudes, actividad y roles internos"
        }
      : null;
---

<article class="case-card js-case-card js-reveal-card" data-card-interaction>
  {projectImage && (
    <figure class="case-visual">
      <Picture
        src={projectImage.src}
        widths={[640, 960, 1280, 1586]}
        sizes="(min-width: 1081px) 50vw, 100vw"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        width={1586}
        height={992}
        alt={projectImage.alt}
        loading="lazy"
      />
      <figcaption>Visualización conceptual · Datos ficticios</figcaption>
    </figure>
  )}
  <div class="case-meta">
    {metaLabels.map((label) => <span>{label}</span>)}
  </div>
  <h3>{caseStudy.title}</h3>
  <p>{caseStudy.summary}</p>
  <dl class="case-flow">
    <div>
      <dt>Problema</dt>
      <dd>{caseStudy.problem}</dd>
    </div>
    <div>
      <dt>Intervención</dt>
      <dd>{caseStudy.solution}</dd>
    </div>
    <div>
      <dt>Resultado cualitativo</dt>
      <dd>{caseStudy.outcomes[0]}</dd>
    </div>
  </dl>
  <div>
    <p class="eyebrow">Servicios y temas</p>
    <div class="case-tags">
      {caseTags.map((tag) => <span>{tag}</span>)}
    </div>
  </div>
  <p class="case-note">{caseStudy.confidentialityNote}</p>
  <a class="button button-ghost" href={caseStudy.ctaHref} data-link-shift>{caseStudy.ctaLabel}</a>
</article>
