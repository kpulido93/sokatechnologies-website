---
import { contactServiceOptions } from "../lib/site";

interface Props {
  formType: "contact" | "diagnostico";
  title: string;
  body: string;
  buttonLabel: string;
}

const { formType, title, body, buttonLabel } = Astro.props;
const provider = import.meta.env.PUBLIC_FORM_PROVIDER?.trim().toLowerCase() || "demo";
const submitEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT?.trim() || "";
const fallbackEmail = import.meta.env.PUBLIC_CONTACT_FALLBACK_EMAIL?.trim() || "info@sokatechnologies.com";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || "";

const isAllowedEndpoint = (value: string) => {
  try {
    const url = new URL(value);
    const localHost = ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname);
    return (url.protocol === "https:" || (url.protocol === "http:" && localHost)) && !url.username && !url.password && !url.hash;
  } catch {
    return false;
  }
};

const isLiveMode = provider === "worker" && isAllowedEndpoint(submitEndpoint) && Boolean(turnstileSiteKey);
const formId = `${formType}-form`;
const successId = `${formId}-success`;
const errorId = `${formId}-error`;
const noteId = `${formId}-note`;
---

<section class="contact-panel js-reveal">
  <div class="contact-copy">
    <p class="eyebrow">Diagnóstico B2B</p>
    <h2>{title}</h2>
    <p>{body}</p>
    <ul class="contact-guidelines">
      <li>No envíes contraseñas, tokens, llaves privadas ni accesos.</li>
      <li>Describe el problema, el proceso afectado y las herramientas actuales.</li>
      <li>Si el alcance no está claro, el siguiente paso recomendado es diagnóstico.</li>
    </ul>
  </div>

  <form
    class="contact-form"
    method="post"
    action={isLiveMode ? submitEndpoint : `mailto:${fallbackEmail}`}
    enctype="application/x-www-form-urlencoded"
    data-form-mode={isLiveMode ? "live" : "demo"}
    data-form-provider={isLiveMode ? provider : "demo"}
    data-success-id={successId}
    data-error-id={errorId}
    aria-describedby={`${noteId} ${successId} ${errorId}`}
  >
    <input type="hidden" name="formType" value={formType} />
    <input type="hidden" name="formContext" value={title} />

    <label class="form-trap" aria-hidden="true">
      <span>Website</span>
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>

    <div class="field-grid">
      <label>
        <span>Nombre</span>
        <input type="text" name="name" autocomplete="name" minlength="2" maxlength="80" required />
      </label>
      <label>
        <span>Empresa</span>
        <input
          type="text"
          name="company"
          autocomplete="organization"
          minlength="2"
          maxlength="120"
          required
        />
      </label>
      <label>
        <span>Correo electrónico</span>
        <input type="email" name="email" autocomplete="email" inputmode="email" maxlength="254" required />
      </label>
      <label>
        <span>Teléfono <small>(opcional)</small></span>
        <input type="tel" name="phone" autocomplete="tel" maxlength="40" />
      </label>
      <label>
        <span>País <small>(opcional)</small></span>
        <input type="text" name="country" autocomplete="country-name" maxlength="80" />
      </label>
      <label>
        <span>Servicio de interés <small>(opcional)</small></span>
        <select name="service">
          <option value="">Selecciona una opción</option>
          {contactServiceOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
      </label>
      <label>
        <span>Tipo de problema <small>(opcional)</small></span>
        <select name="problemType">
          <option value="">Selecciona una opción</option>
          <option value="manual">Proceso manual o disperso</option>
          <option value="reporting">Reportes o indicadores</option>
          <option value="infra">Infraestructura o continuidad</option>
          <option value="web">Sitio web o presencia digital</option>
        </select>
      </label>
    </div>

    <label class="field-block">
      <span>Descripción del problema</span>
      <textarea name="summary" rows="5" minlength="30" maxlength="1200" required></textarea>
    </label>

    <label class="checkbox-line">
      <input type="checkbox" name="consent" value="true" required />
      <span>
        Acepto que SokaTechnologies me contacte sobre esta solicitud y confirmo que no incluiré
        contraseñas, tokens, llaves privadas ni datos sensibles. Consulta la
        <a href="/politica-privacidad/">política de privacidad</a>.
      </span>
    </label>

    {
      isLiveMode && turnstileSiteKey && (
        <>
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="lead" data-theme="auto"></div>
          <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        </>
      )
    }

    <div class="form-actions">
      <button class="button button-primary" type="submit">{buttonLabel}</button>
      <a class="button button-ghost" href={`mailto:${fallbackEmail}`} data-link-shift>
        Escribir por correo
      </a>
    </div>

    <p id={successId} class="form-status" role="status" aria-live="polite" hidden>
      {isLiveMode
        ? "Solicitud enviada correctamente. Te contactaremos usando el correo indicado."
        : "Validación local completada. El formulario está en modo demo y no se envió ninguna solicitud. Escríbenos al correo corporativo para contactarnos."}
    </p>

    <p id={errorId} class="form-status form-status-error" role="alert" aria-live="assertive" hidden>
      No se pudo enviar la solicitud. Revisa los campos o usa el correo corporativo como alternativa.
    </p>

    <p id={noteId} class="form-note">
      {isLiveMode
        ? "Envío seguro: la solicitud se valida en un Worker y se entrega por correo sin exponer credenciales."
        : "Modo demo: el formulario valida los campos, pero no envía ni almacena datos. Usa el correo corporativo para iniciar la conversación."}
    </p>

    <noscript>
      <p class="form-note">
        JavaScript está desactivado. Usa el botón de correo para enviar la solicitud desde tu cliente de email.
      </p>
    </noscript>
  </form>
</section>

<script is:inline>
  document.querySelectorAll(".contact-form").forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;

    const successNode = document.getElementById(form.dataset.successId ?? "");
    const errorNode = document.getElementById(form.dataset.errorId ?? "");
    const mode = form.dataset.formMode ?? "demo";
    const submitButton = form.querySelector('button[type="submit"]');
    const originalLabel = submitButton instanceof HTMLButtonElement ? submitButton.textContent : "";
    let submitting = false;
    const createIdempotencyKey = () => {
      if (globalThis.crypto?.randomUUID) return globalThis.crypto.randomUUID();
      if (globalThis.crypto?.getRandomValues) {
        const bytes = new Uint8Array(16);
        globalThis.crypto.getRandomValues(bytes);
        return Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");
      }
      return `${Date.now()}-${Math.random().toString(36).slice(2)}`;
    };
    let idempotencyKey = createIdempotencyKey();

    const setStatus = (target) => {
      [successNode, errorNode].forEach((node) => {
        if (!(node instanceof HTMLElement)) return;
        node.hidden = node !== target;
      });
    };

    const setBusy = (busy) => {
      form.setAttribute("aria-busy", String(busy));
      if (!(submitButton instanceof HTMLButtonElement)) return;
      submitButton.disabled = busy;
      submitButton.textContent = busy ? "Enviando…" : originalLabel;
    };

    form.addEventListener(
      "invalid",
      () => {
        setStatus(errorNode instanceof HTMLElement ? errorNode : null);
      },
      true,
    );

    form.addEventListener("input", () => setStatus(null));

    form.addEventListener("submit", async (event) => {
      const trap = form.elements.namedItem("website");

      if (trap instanceof HTMLInputElement && trap.value.trim().length > 0) {
        event.preventDefault();
        setStatus(errorNode instanceof HTMLElement ? errorNode : null);
        return;
      }

      if (!form.checkValidity()) {
        event.preventDefault();
        form.reportValidity();
        setStatus(errorNode instanceof HTMLElement ? errorNode : null);
        return;
      }

      if (mode === "demo") {
        event.preventDefault();
        setStatus(successNode instanceof HTMLElement ? successNode : null);
        return;
      }

      event.preventDefault();
      if (submitting) return;
      submitting = true;
      setBusy(true);
      setStatus(null);

      try {
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());
        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
            "Idempotency-Key": idempotencyKey
          },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || result?.ok !== true) throw new Error("lead_submission_failed");

        form.reset();
        idempotencyKey = createIdempotencyKey();
        if (window.turnstile && typeof window.turnstile.reset === "function") window.turnstile.reset();
        setStatus(successNode instanceof HTMLElement ? successNode : null);
      } catch {
        setStatus(errorNode instanceof HTMLElement ? errorNode : null);
      } finally {
        submitting = false;
        setBusy(false);
      }
    });
  });
</script>
