# Placeholders seguros para configuracion local o de despliegue

# SEO y sitio
SITE_URL=https://example.com
CONTACT_EMAIL=info@sokatechnologies.com

# Analytics
ANALYTICS_PROVIDER=none
ANALYTICS_ID=replace-me

# Formularios - variables publicas seguras para el cliente.
# Mantener demo y el endpoint vacio hasta aprobar el Worker y sus dominios.
PUBLIC_FORM_PROVIDER=demo
PUBLIC_CONTACT_FORM_ENDPOINT=
PUBLIC_CONTACT_FALLBACK_EMAIL=info@sokatechnologies.com
PUBLIC_CONTACT_WHATSAPP_URL=
PUBLIC_TURNSTILE_SITE_KEY=

# Worker - configuración no secreta; se define preferiblemente en wrangler.toml.
# Preparación de staging; no activar sin revisión del endpoint y del widget.
ALLOWED_ORIGINS=https://prueba.sokatechnologies.com
TURNSTILE_EXPECTED_HOSTNAME=prueba.sokatechnologies.com
TURNSTILE_EXPECTED_ACTION=lead

# Formularios - variables privadas solo para Worker o plataforma; nunca se exponen al cliente.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
PAGESPEED_API_KEY=
RESEND_FROM_EMAIL=leads@example.com
LEADS_TO_EMAIL=info@sokatechnologies.com

# Auditoria - captura de leads server-side (no exponer en cliente)
AUDIT_LEAD_PROVIDER=none
AUDIT_RATE_LIMIT_MAX=5
AUDIT_RATE_LIMIT_WINDOW_SECONDS=60
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIT_LEADS_TABLE=audit_leads
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Audit Leads
GOOGLE_APPS_SCRIPT_AUDIT_WEBHOOK_URL=
CLOUDFLARE_D1_DATABASE_ID=
CUSTOM_AUDIT_API_URL=
