RESEND_API_KEY=
PAGESPEED_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
LEADS_TO_EMAIL=hola@sokatechnologies.com

# Auditoria - captura de leads server-side (no exponer en cliente)
