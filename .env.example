# Placeholders seguros para configuracion local o de despliegue

# SEO y sitio
SITE_URL=https://example.com
CONTACT_EMAIL=contact@example.com

# Analytics
ANALYTICS_PROVIDER=none
ANALYTICS_ID=replace-me

# Formularios - variables publicas seguras para el cliente
